{
  "manifest_version": 3,
  "name": "Simple Player Discord Presence",
  "version": "1.0.0",
  "description": "把電腦版 Simple Player 正在播放的歌曲顯示在 Discord 狀態（搭配 SimplePlayerPresence.exe，不用登入）。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:47823/*"
  ]
}